<%- include("./partials/header.ejs") %>
<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="/styles/main.css">
</head>
<body>
    <% for(let i=0;i<books.length;i++) {%>
        <div class="container">
        <div class = "image">
            <% const imageUrl = `https://covers.openlibrary.org/b/olid/${covers[i]}-L.jpg` %>
            <% if (imageUrl) { %>
               <img src="<%= imageUrl %>" alt="Book cover">
            <% } else { %>
                <div><p>No image available</p></div>
            <% } %>
        </div>
        <div class="review">
            <h1>Title: <%= books[i].title || 'Untitled Book' %></h1>
            <h3>Author: <%= books[i].author || 'Unknown Author' %></h3>
            <hr style="width: 100%;"/>
            <br/>
            <h4>Review:</h4>
            <p><%= books[i].review || 'No review provided yet.' %></p>
            <div class="rating" style="display:flex;gap: 15px;">
                <span>Rating: </span>
                <div>
                <% for(let star = 1; star <= 5; star++) { %>
                <% if(star <= books[i].rating) { %>
                    <i class="bi bi-star-fill star-filled"></i>
                <% } else { %>
                    <i class="bi bi-star star-empty"></i>
                <% } %>

                <% } %>
                </div>
            </div>
            <h5>Date and Time of Review: <%= books[i].date_time  || 'Unknown Time' %> </h5>
            <div class="options">
               <div>
                <form action="/edit/<%= books[i].id %>" method="get">
                    <input type="hidden" name="edit" value="<%= books[i].id %>">
                    <button type="submit" class="btn btn-primary">Edit</button>
                </form>
            </div> 
            <div>
                <form action="/delete/<%= books[i].id %>" method="post">
                    <input type="hidden" name="delete" value="<%= books[i].id %>">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
            </div>
            
            
        </div>
    </div>
    <hr/>
   <% } %>     
</body>
</html>